## Firebase Hosting (Production) environment template
## Copy to `.env.production` and fill values as needed.

# ---- App mode switches ----
# 暫時跳過登入（僅用於 demo/前端驗收；正式環境請務必關閉）
VITE_BYPASS_AUTH=false

# 認證模式：firebase | token
# Firebase Hosting 正式部署通常使用 firebase
VITE_AUTH_MODE=token

# 後端 API Base URL
# - 若前端與後端同網域且有反向代理，可留空或用 /api
# - Firebase Hosting 通常需要填完整後端網域（例：https://api.example.com/api）
VITE_API_BASE_URL=https://web-production-8eb28.up.railway.app/api

# ---- Firebase Web App config ----
# 這些是 Firebase Web 的公開設定（非 Admin 金鑰）
VITE_FIREBASE_API_KEY=AIzaSyACjFt3GUrog6tyn__lw5XNQcE_-GKdGf8
VITE_FIREBASE_AUTH_DOMAIN=intelligent-scheduling-system.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=intelligent-scheduling-system
VITE_FIREBASE_STORAGE_BUCKET=intelligent-scheduling-system.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=835212009034
VITE_FIREBASE_APP_ID=1:835212009034:web:ea66073b378d62c3a610b3

